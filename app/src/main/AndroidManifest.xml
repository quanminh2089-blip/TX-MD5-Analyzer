<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <queries><package android:name="com.garena.game.kgvn"/></queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round" android:theme="@style/MinhQuanTheme"
        android:usesCleartextTraffic="false" android:allowBackup="false">
        <service android:name=".EspOverlayService" android:exported="false"/>
        <service android:name=".BotAccessibilityService" android:exported="true"
            android:label="MinhQuan điều khiển"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/bot_accessibility_service"/>
        </service>
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
